            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus"
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "DocumentType": {
        "type": "string",
        "enum": ["passport", "drivers_license", "national_id", "utility_bill", "bank_statement", "tax_return"]
      },
      "DocumentStatus": {
        "type": "string",
        "enum": ["uploaded", "pending_verification", "verified", "rejected", "expired"]
      },
      "KycUpdate": {
        "type": "object",
        "required": ["documents"],
        "properties": {
          "documents": {
            "type": "array",
