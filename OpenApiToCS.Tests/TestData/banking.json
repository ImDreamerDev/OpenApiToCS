            "$ref": "#/components/schemas/EmploymentInfo"
          },
          "annualIncome": {
            "$ref": "#/components/schemas/Money"
          },
          "monthlyExpenses": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "LoanType": {
        "type": "string",
        "enum": ["personal", "auto", "mortgage", "business", "student", "line_of_credit"]
