{
  "openapi": "3.1.0",
  "info": {
    "title": "Payment API",
    "version": "1.0.0",
    "description": "API with webhook notifications for payment events"
  },
  "paths": {
    "/payments": {
      "post": {
        "operationId": "createPayment",
        "summary": "Create a new payment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {
    "paymentCompleted": {
      "post": {
        "operationId": "onPaymentCompleted",
        "summary": "Notifies when a payment is completed successfully",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentCompletedEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook received"
          }
        }
      }
    },
    "paymentFailed": {
      "post": {
        "operationId": "onPaymentFailed",
        "summary": "Notifies when a payment fails",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentFailedEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook received"
          }
        }
      }
    },
    "refundProcessed": {
      "post": {
        "operationId": "onRefundProcessed",
        "summary": "Notifies when a refund is processed",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefundEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook received"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreatePaymentRequest": {
        "type": "object",
        "required": ["amount", "currency"],
        "properties": {
          "amount": {
            "type": "number",
            "format": "decimal",
            "description": "Payment amount"
          },
          "currency": {
            "type": "string",
            "description": "Currency code (e.g., USD, EUR)"
          },
          "description": {
            "type": "string",
            "description": "Payment description"
          }
        }
      },
      "Payment": {
        "type": "object",
        "required": ["id", "amount", "currency", "status"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Payment ID"
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "completed", "failed"]
          },
          "description": {
            "type": ["string", "null"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PaymentCompletedEvent": {
        "type": "object",
        "required": ["eventId", "paymentId", "amount", "currency", "completedAt"],
        "properties": {
          "eventId": {
            "type": "string",
            "description": "Unique event ID"
          },
          "paymentId": {
            "type": "string",
            "description": "Payment ID that was completed"
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "currency": {
            "type": "string"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PaymentFailedEvent": {
        "type": "object",
        "required": ["eventId", "paymentId", "reason", "failedAt"],
        "properties": {
          "eventId": {
            "type": "string",
            "description": "Unique event ID"
          },
          "paymentId": {
            "type": "string",
            "description": "Payment ID that failed"
          },
          "reason": {
            "type": "string",
            "description": "Failure reason"
          },
          "failedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RefundEvent": {
        "type": "object",
        "required": ["eventId", "paymentId", "refundId", "amount", "processedAt"],
        "properties": {
          "eventId": {
            "type": "string",
            "description": "Unique event ID"
          },
          "paymentId": {
            "type": "string",
            "description": "Original payment ID"
          },
          "refundId": {
            "type": "string",
            "description": "Refund ID"
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "processedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
